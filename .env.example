# Copy to .env.local for local development. Production values live in Vercel → Settings → Environment Variables.

# Google Tag Manager container (GTM-XXXXXXX). Unset = no consent banner, no GA4.
NEXT_PUBLIC_GTM_ID=

# Contact form (src/app/api/contact/route.ts). Unset = the form shows its error state.
# Resend API key with "Sending access", scoped to the brzezina.dev domain.
RESEND_API_KEY=
# Inbox that receives contact form messages.
CONTACT_TO_EMAIL=
# Optional sender; must be on the domain verified in Resend. Defaults to "brzezina.dev <contact@brzezina.dev>".
CONTACT_FROM_EMAIL=
