    "@radix-ui/react-slot": "^1.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^15.5.27",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.33.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
